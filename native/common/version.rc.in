#include <windows.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CAMBER_VERSION_NUMERIC@
 PRODUCTVERSION @CAMBER_VERSION_NUMERIC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @CAMBER_FILE_TYPE@
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Camber\0"
   VALUE "ProductName", "Camber Camera\0"
   VALUE "FileDescription", "@CAMBER_BINARY_NAME@\0"
   VALUE "FileVersion", "@CAMBER_BUILD_VERSION@\0"
   VALUE "ProductVersion", "@CAMBER_BUILD_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
