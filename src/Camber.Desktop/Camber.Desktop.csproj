<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI><WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained><ApplicationManifest>app.manifest</ApplicationManifest>
    <ImplicitUsings>disable</ImplicitUsings><Platforms>x64</Platforms><Platform>x64</Platform>
    <ApplicationIcon>Assets\Camber.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Camber.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.260803003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250829.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <ProjectReference Include="../Camber.Core/Camber.Core.csproj" />
    <ProjectReference Include="../Camber.Tray/Camber.Tray.csproj" />
  </ItemGroup>
  <!-- WinUI creates this merged resource index during Build, but the SDK's
       unpackaged Publish pipeline does not include it automatically. -->
  <Target Name="PublishCamberXamlResources" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The compiled Camber interface resource index is missing. Build the desktop project before packaging." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
        <RelativePath>$(AssemblyName).pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="ValidateCamberPublishedResources" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)$(AssemblyName).pri')" Text="The published Camber application is missing its interface resources. Do not build an installer from this output." />
  </Target>
</Project>
